{
    "name": "andywer/js-localization",
    "description": "Laravel package to provide localizations to the Javascript code.",
    "keywords": ["laravel", "javascript", "localization", "translation", "messages"],
    "license": "MIT",
    "authors": [
        {
            "name": "Andy Wermke",
            "email": "andy@dev.next-step-software.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "JsLocalization\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "JsLocalization\\JsLocalizationServiceProvider"
            ],
            "aliases": {
                "JsLocalizationHelper": "JsLocalization\\Facades\\JsLocalizationHelper"
            }
        },
        "component": "package",
        "frameworks": ["Laravel 10", "Laravel 11", "Laravel 12", "Laravel 13"]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
